# Python bytecode / cache -- generated by running any scripts/*.py, must never be committed
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments -- if you set one up locally to install playwright, keep it out of git
.venv/
venv/
env/

# Playwright -- local browser binaries/cache (installed via `playwright install chromium`),
# never source, and far too large for the 50MB submission zip
.playwright/
playwright-report/
test-results/

# Runtime artifacts produced by running the audit -- these are outputs, not part of the skill
# definitions, and should never be mistaken for part of the submission
evidence.json
*.findings.json
audit_report*.json
final_report*.json
*-report.json

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local env/secrets -- none of these skills need credentials, but keep the door shut
.env
.env.*

# Packaged submission zip -- built from this folder, shouldn't live inside it
*.zip
